{
  "name": "abdulsalam/laravel-context-flow",
  "description": "Distributed context propagation, correlation and trust-aware boundary policies on top of Laravel Context.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "context",
    "correlation-id",
    "distributed-systems",
    "observability",
    "baggage",
    "queues"
  ],
  "require": {
    "illuminate/console": "^12.0|^13.0",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/events": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/log": "^12.0|^13.0",
    "illuminate/queue": "^12.0|^13.0",
    "illuminate/routing": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "php": "^8.2",
    "psr/http-message": "^1.1|^2.0"
  },
  "require-dev": {
    "guzzlehttp/psr7": "^2.7",
    "laravel/framework": "^12.0|^13.0",
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Abdulsalam\\LaravelContextFlow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Abdulsalam\\LaravelContextFlow\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Abdulsalam\\LaravelContextFlow\\ContextFlowServiceProvider"
      ],
      "aliases": {
        "ContextFlow": "Abdulsalam\\LaravelContextFlow\\Facades\\ContextFlow"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
